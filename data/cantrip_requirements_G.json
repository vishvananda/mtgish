[
 {
  "match": "^engine: no perpetual effects$",
  "class": "engine",
  "needs": "Changes that stay with an object through every zone for the rest of the game (Alchemy \"perpetually\"), held on the card and not on the permanent. Alchemy only, so Cantrip has no reason to play it unless it plays digital cards.",
  "api": "cantrip_mechanics::perpetual::apply(g, source, object, Perpetual::{Effect,Rules,Incorporate,SpendAsThoughAnyType})"
 },
 {
  "match": "^engine: no commander$",
  "class": "engine",
  "needs": "The commander designation (CR 903.3): Cantrip games have none, so a casual-format form it has no reason to support unless it adds the variant.",
  "api": "Query::is_commander(id)"
 },
 {
  "match": "^engine: no Ring temptation$",
  "class": "engine",
  "needs": "The Ring emblem and Ring-bearer designation (CR 701.54).",
  "api": "cantrip_mechanics::ring::tempt(g, player, source)"
 },
 {
  "match": "^engine: venture into the dungeon reaches only Undercity$",
  "class": "engine",
  "needs": "Venture must offer the three dungeons (CR 701.49a): Game::venture only knows Undercity.",
  "api": "Game::venture(player), with the three dungeons in CardDef::dungeon"
 },
 {
  "match": "^engine: no untap event$",
