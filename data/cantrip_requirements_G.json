  "api": "Event::Untapped { permanent }, EventMask::UNTAPPED"
 },
 {
  "match": "^engine: no mutate event$",
  "class": "engine",
  "needs": "An event when a permanent mutates (CR 702.140).",
  "api": "Event::Mutated { permanent }, EventMask::MUTATED"
 },
 {
  "match": "^engine: no specialize event$",
  "class": "engine",
