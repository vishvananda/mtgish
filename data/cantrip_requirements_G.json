 },
 {
  "match": "^engine: no crew event$",
  "class": "engine",
  "needs": "Event::Crewed is recorded in the history but not emitted: abilities that trigger on a creature crewing never see it (a question of who crewed already compiles).",
  "api": "emit Event::Crewed, EventMask::CREWED"
 },
 {
  "match": "^engine: no saddle event$",
  "class": "engine",
  "needs": "An event for a creature saddling a Mount (CR 702.171), in the history and to abilities.",
  "api": "Event::Saddled { creature, mount }, EventMask::SADDLED"
 },
 {
  "match": "^engine: no ability triggers on losing the game$",
  "class": "engine",
  "needs": "Event::GameLost is filed in the history only: it must reach triggers.",
  "api": "emit Event::GameLost, EventMask::GAME_LOST"
 },
 {
  "match": "^engine: no event for dice rolled together$",
  "class": "engine",
  "needs": "One event for all the dice a player rolled at once.",
  "api": "Event::DiceRolled { player, .. }, EventMask::DICE_ROLLED"
 },
 {
  "match": "^engine: no event for a counter being removed$",
  "class": "engine",
  "needs": "An event for counters leaving an object, with the kind and how many.",
  "api": "Event::CountersRemoved { object, kind, amount, by, .. }, EventMask::COUNTERS_REMOVED"
 },
 {
  "match": "^engine: no event for each counter put$",
  "class": "engine",
  "needs": "Abilities that trigger once for each counter put: CountersPut is one event for the put, however many counters.",
  "api": "a per-counter firing of Event::CountersPut (TriggeredDef counted by amount)"
 },
 {
  "match": "^engine: no discard cause in events$",
  "class": "engine",
  "needs": "What caused a discard, to a matcher: the record has a Cause but the event does not carry it.",
  "api": "Event::Discarded { cause, .. }"
 },
 {
  "match": "^engine: only a mana ability triggers on tapping for mana$",
