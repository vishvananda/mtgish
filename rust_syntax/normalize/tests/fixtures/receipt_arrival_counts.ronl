Card(Name: "Receipt Arrival Test", Typeline: (Supertypes: [], Cardtypes: [Sorcery], Subtypes: []), ManaCost: [], Rules: [SpellActions(ActionList([Exile([NumberCardsInGraveyards(Integer(1), And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]))], []), PutExiledCardIntoOwnersHand(TheCardExiledThisWay), DrawNumberCards(NumberOfCardsOfTypeExiledThisWay(IsCardtype(Creature)))]))])
Card(Name: "Receipt Membership Test", Typeline: (Supertypes: [], Cardtypes: [Sorcery], Subtypes: []), ManaCost: [], Rules: [SpellActions(ActionList([Exile([NumberCardsInGraveyards(Integer(1), And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]))], []), PutExiledCardIntoOwnersHand(TheCardExiledThisWay), If(TheCardExiledThisWayIsStillExiled, [DrawACard])]))])
