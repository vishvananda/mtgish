Card(Name: "Nameless Race", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: []), ManaCost: [ManaCostGeneric(3), ManaCostB], Rules: [Trample, AsPermanentEnters(ThisPermanent, [PayAnyAmountOfLifeUpto(Plus(TheNumberOfPermanentsOnTheBattlefield(And([IsColor(White), IsNonToken, ControlledByAPlayer(Opponent)])), TheNumberOfGraveyardCards(And([IsColor(White), InAPlayersGraveyard(Opponent)]))))]), PermanentLayerEffect(ThisPermanent, [SetPowerAndToughnessBoth(TheLifePaid)])], CardPT: (Power: 0, Toughness: 0))
Card(Name: "Power Sink", Typeline: (Supertypes: [], Cardtypes: [Instant], Subtypes: []), ManaCost: [ManaCostX, ManaCostU], Rules: [SpellActions(Targeted([TargetSpell(AnySpell)], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaX([ManaCostX], ValueX)), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell), PlayerActions(ControllerOfSpell(Ref_TargetSpell), [TapEachPermanent(And([IsCardtype(Land), HasAbility(ManaAbility), ControlledByAPlayer(SinglePlayer(ActionPlayer))])), LoseUnspentMana])])])))])
