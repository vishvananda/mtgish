Card(Name: "Two-Headed Giant", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: [Giant, Warrior]), ManaCost: [ManaCostGeneric(2), ManaCostR, ManaCostR], Rules: [TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), ActionList([FlipCoins(Integer(2)), If(ValueIs(TheNumberOfCoinsThatCameUpHeads, EqualTo(Integer(2))), [CreatePermanentLayerEffectUntil(ThisPermanent, [AddAbility([DoubleStrike])], UntilEndOfTurn)]), If(ValueIs(TheNumberOfCoinsThatCameUpHeads, EqualTo(Integer(0))), [CreatePermanentLayerEffectUntil(ThisPermanent, [AddAbility([Menace])], UntilEndOfTurn)])]))], CardPT: (Power: 4, Toughness: 4))
