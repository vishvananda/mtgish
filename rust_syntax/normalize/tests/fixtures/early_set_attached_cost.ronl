Card(Name: "Earthlore", Typeline: (Supertypes: [], Cardtypes: [Enchantment], Subtypes: [Aura]), ManaCost: [ManaCostG], Rules: [EnchantPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])), ActivatedWithModifiers(TapPermanent(HostPermanent), Targeted([TargetPermanent(And([IsBlocking, IsCardtype(Creature)]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT(+1, +2)], UntilEndOfTurn)])), ActivateOnlyIf(PermanentPassesFilter(HostPermanent, IsUntapped)))])
Card(Name: "Tourach's Gate", Typeline: (Supertypes: [], Cardtypes: [Enchantment], Subtypes: [Aura]), ManaCost: [ManaCostGeneric(1), ManaCostB, ManaCostB], Rules: [EnchantPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])), Activated(SacrificeAPermanent(IsCreatureType(Thrull)), ActionList([PutCounters([NumberCountersOfTypeOnPermanent(Integer(3), TimeCounter, ThisPermanent)])])), TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([RemoveCounters([ACounterOfTypeFromPermanent(TimeCounter, ThisPermanent)]), If(PermanentPassesFilter(ThisPermanent, HasNoCountersOfType(TimeCounter)), [SacrificePermanent(ThisPermanent)])])), ActivatedWithModifiers(TapPermanent(HostPermanent), ActionList([CreateEachPermanentLayerEffectUntil(And([IsAttacking, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [AdjustPT(+2, -1)], UntilEndOfTurn)]), ActivateOnlyIf(PermanentPassesFilter(HostPermanent, IsUntapped)))])
