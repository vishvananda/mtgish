Card(Name: "Drain Power", Typeline: (Supertypes: [], Cardtypes: [Sorcery], Subtypes: []), ManaCost: [ManaCostU, ManaCostU], Rules: [SpellActions(Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, ActivateAManaAbilityOfEachPermanentAndLoseUnspentMana(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), AddMana(TheManaLostThisWay)])))])
Card(Name: "Mana Short", Typeline: (Supertypes: [], Cardtypes: [Instant], Subtypes: []), ManaCost: [ManaCostGeneric(2), ManaCostU], Rules: [SpellActions(Targeted([TargetPlayer(AnyPlayer)], ActionList([TapEachPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), PlayerAction(Ref_TargetPlayer, LoseUnspentMana)])))])
Card(Name: "Power Sink", Typeline: (Supertypes: [], Cardtypes: [Instant], Subtypes: []), ManaCost: [ManaCostX, ManaCostU], Rules: [SpellActions(Targeted([TargetSpell(AnySpell)], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaX([ManaCostX], ValueX)), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell), PlayerActions(ControllerOfSpell(Ref_TargetSpell), [TapEachPermanent(And([IsCardtype(Land), HasAbility(ManaAbility), ControlledByAPlayer(SinglePlayer(ActionPlayer))])), LoseUnspentMana])])])))])
Card(Name: "Doubling Cube", Typeline: (Supertypes: [], Cardtypes: [Artifact], Subtypes: []), ManaCost: [ManaCostGeneric(2)], Rules: [Activated(And([PayMana([ManaCostGeneric(3)]), TapPermanent(ThisPermanent)]), ActionList([DoubleEachTypeOfUnspentMana]))])
