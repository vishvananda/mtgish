Card(Name: "Krav, the Unredeemed", Typeline: (Supertypes: [Legendary], Cardtypes: [Creature], Subtypes: [Demon]), ManaCost: [ManaCostGeneric(4), ManaCostB], Rules: [DeckConstruction(PartnerWith("Regna, the Redeemer")), Activated(And([PayMana([ManaCostB]), SacrificeNumberPermanents(ValueX, IsCardtype(Creature))]), Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerActions(Ref_TargetPlayer, [DrawNumberCards(ValueX), GainLife(ValueX)]), PutCounters([NumberCountersOfTypeOnPermanent(ValueX, PTCounter(+1, +1), ThisPermanent)])])))], CardPT: (Power: 3, Toughness: 3))
