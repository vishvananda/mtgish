Card(Name: "Frodo, Sauron's Bane", Typeline: (Supertypes: [Legendary], Cardtypes: [Creature], Subtypes: [Halfling, Citizen]), ManaCost: [ManaCostW], Rules: [Activated(PayMana([ManaCostWB, ManaCostWB]), ActionList([If(PermanentPassesFilter(ThisPermanent, IsCreatureType(Citizen)), [CreatePermanentLayerEffect(ThisPermanent, [SetCreatureTypes([Halfling, Scout]), SetPT(PT(2, 3)), AddAbility([Lifelink])])])])), Activated(PayMana([ManaCostB, ManaCostB, ManaCostB]), ActionList([If(PermanentPassesFilter(ThisPermanent, IsCreatureType(Scout)), [CreatePermanentLayerEffect(ThisPermanent, [SetCreatureTypes([Halfling, Rogue]), AddAbility([TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), ActionList([IfElse(PlayerPassesFilter(You, HasBeenTemptedByTheRingNumberTimes(GreaterThanOrEqualTo(Integer(4)))), [PlayerAction(Trigger_ThatPlayer, LoseTheGame)], [TemptWithRing])]))])])])]))], CardPT: (Power: 1, Toughness: 2))
