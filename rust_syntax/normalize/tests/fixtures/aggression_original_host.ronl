Card(Name: "Aggression", Typeline: (Supertypes: [], Cardtypes: [Enchantment], Subtypes: [Aura]), ManaCost: [ManaCostGeneric(2), ManaCostR], Rules: [EnchantPermanent(And([IsNonCreatureType(Wall), IsCardtype(Creature)])), PermanentLayerEffect(HostPermanent, [AddAbility([FirstStrike]), AddAbility([Trample])]), TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(HostController)), ActionList([If(PermanentPassesFilter(Trigger_ThatPermanent, DidntAttackThisTurn), [DestroyPermanent(Trigger_ThatPermanent)])]))])
Card(Name: "Insubordination", Typeline: (Supertypes: [], Cardtypes: [Enchantment], Subtypes: [Aura]), ManaCost: [ManaCostB, ManaCostB], Rules: [EnchantPermanent(IsCardtype(Creature)), TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(HostController)), ActionList([Unless(PermanentPassesFilter(Trigger_ThatPermanent, AttackedThisTurn), [PermanentDealsDamage(ThisPermanent, Integer(2), Player(Trigger_ThatPlayer))])]))])
Card(Name: "Lingering Death", Typeline: (Supertypes: [], Cardtypes: [Enchantment], Subtypes: [Aura]), ManaCost: [ManaCostGeneric(1), ManaCostB], Rules: [EnchantPermanent(IsCardtype(Creature)), TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(HostController)), ActionList([PlayerAction(Trigger_ThatPlayer, SacrificePermanent(Trigger_ThatPermanent))]))])
