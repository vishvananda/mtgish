Card(Name: "Blood of the Martyr", Typeline: (Supertypes: [], Cardtypes: [Instant], Subtypes: []), ManaCost: [ManaCostW, ManaCostW, ManaCostW], Rules: [SpellActions(ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtToARecipient(APermanent(IsCardtype(Creature))), [MayActions([DealToPlayerInstead(You)])], UntilEndOfTurn)]))])
Card(Name: "Call to Arms", Typeline: (Supertypes: [], Cardtypes: [Enchantment], Subtypes: []), ManaCost: [ManaCostGeneric(1), ManaCostW], Rules: [AsPermanentEnters(ThisPermanent, [ChooseAColor(AnyColor), ChooseAPlayer(Opponent)]), If(AColorIsTheMostCommonColorAmongPermanentsButNotTiedForTheMostComon(TheChosenColor, And([IsNonToken, ControlledByAPlayer(SinglePlayer(TheChosenPlayer))])), [EachPermanentLayerEffect(And([IsColor(White), IsCardtype(Creature)]), [AdjustPT(+1, +1)])]), TriggerA(WhenAColorIsntTheMostCommonOrTiedForMostCommonColorAmongPermanents(TheChosenColor, And([IsNonToken, ControlledByAPlayer(SinglePlayer(TheChosenPlayer))])), ActionList([SacrificePermanent(ThisPermanent)]))])
