Card(Name: "Dream Thief", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: [Faerie, Rogue]), ManaCost: [ManaCostGeneric(2), ManaCostU], Rules: [Flying, TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), ActionList([If(EnteringPermanentPassesFilter(PlayerHasCastAnotherSpellThisTurn(You, IsColor(Blue))), [DrawACard])]))], CardPT: (Power: 2, Toughness: 1))
Card(Name: "Hotheaded Giant", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: [Giant, Warrior]), ManaCost: [ManaCostGeneric(3), ManaCostR], Rules: [Haste, AsPermanentEnters(ThisPermanent, [Unless(EnteringPermanentPassesFilter(PlayerHasCastAnotherSpellThisTurn(You, IsColor(Red))), [EntersWithNumberCounters(Integer(2), PTCounter(-1, -1))])])], CardPT: (Power: 4, Toughness: 4))
Scheme(Name: "I Bask in Your Silent Awe", Typeline: (Supertypes: [Ongoing], Cardtypes: [Scheme], Subtypes: []), Rules: [EachPlayerEffect(Opponent, [CantCastMoreThanNumberSpellsEachTurn(Integer(1), AnySpell)]), TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), NoPlayersPassFilter(Opponent, CastASpellSincePlayersLastTurnEnded(AnySpell, You)), ActionList([AbandonScheme(ThisScheme)]))])
Card(Name: "Laboratory Drudge", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: [Zombie, Horror]), ManaCost: [ManaCostGeneric(3), ManaCostU], Rules: [TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), ActionList([If(PlayerPassesFilter(You, Or([CastASpellFromAGraveyardThisTurn(AnySpell, AnyPlayer), HasActivatedAnAbilityOfAGraveyardCardThisTurn(AnyPlayer)])), [DrawACard])]))], CardPT: (Power: 3, Toughness: 4))
Card(Name: "Patrician's Scorn", Typeline: (Supertypes: [], Cardtypes: [Instant], Subtypes: []), ManaCost: [ManaCostGeneric(3), ManaCostW], Rules: [CastEffect(MayCastWithoutPayingIf(PlayerPassesFilter(You, CastASpellThisTurn(IsColor(White))))), SpellActions(ActionList([DestroyEachPermanent(IsCardtype(Enchantment))]))])
Card(Name: "Soul Reap", Typeline: (Supertypes: [], Cardtypes: [Sorcery], Subtypes: []), ManaCost: [ManaCostGeneric(1), ManaCostB], Rules: [SpellActions(Targeted([TargetPermanent(And([IsNonColor(Green), IsCardtype(Creature)]))], ActionList([DestroyPermanent(Ref_TargetPermanent), If(PlayerPassesFilter(You, CastASpellThisTurn(And([Other(ThisSpell), IsColor(Black)]))), [PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), LoseLife(Integer(3)))])])))])
Card(Name: "Spider-Man 2099", Typeline: (Supertypes: [Legendary], Cardtypes: [Creature], Subtypes: [Spider, Human, Hero]), ManaCost: [ManaCostU, ManaCostR], Rules: [CastEffect(CantBeCastIf(IsPlayersNthTurn(You, OneOf([1, 2, 3])))), DoubleStrike, Vigilance, TriggerI(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), PlayerPassesFilter(You, Or([PlayedALandFromAnywhereOtherThanTheirHandThisTurn, CastASpellFromAnywhereOtherThanTheirHandThisTurn(AnySpell)])), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Ref_AnyTarget)])))], CardPT: (Power: 2, Toughness: 3))
Card(Name: "Talara's Battalion", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: [Elf, Warrior]), ManaCost: [ManaCostGeneric(1), ManaCostG], Rules: [CastEffect(CantBeCastUnless(PlayerPassesFilter(You, CastASpellThisTurn(And([Other(ThisSpell), IsColor(Green)]))))), Trample], CardPT: (Power: 4, Toughness: 3))
