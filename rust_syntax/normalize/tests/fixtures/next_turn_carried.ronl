Card(Name: "Kardum, Patron of Flames", Typeline: (Supertypes: [Legendary], Cardtypes: [Creature], Subtypes: [Demon]), ManaCost: [ManaCostGeneric(2), ManaCostR, ManaCostR], Rules: [Haste, TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), ActionList([PutCounters([ACounterOfTypeOnPermanent(FlameCounter, Trigger_ThatCreature)]), SeekACard(ManaValueIs(EqualTo(TheTotalNumberOfCountersOfTypeAmongPermanents(FlameCounter, SinglePermanent(Trigger_ThatCreature))))), Exile([CardInHand(TheCardSeekedThisWay)], [ExilesFaceDown])])), TriggerA(WhenAPermanentDies(SinglePermanent(ThisPermanent)), ActionList([ReturnEachExiledCardToOwnersHand(And([WasExiledWithDeadPermanent, OwnedByAPlayer(SinglePlayer(You))])), CreateFutureTrigger(AtTheBeginningOfPlayersEndStepNextTurn(You), ActionList([DiscardCards(TheCardsReturnedToHandThisWay)]))]))], CardPT: (Power: 4, Toughness: 3))
Card(Name: "Kav Landseeker", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: [Kavu, Soldier]), ManaCost: [ManaCostGeneric(3), ManaCostR], Rules: [Menace, TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), ActionList([CreateTokens([LanderToken], []), CreateFutureTrigger(AtTheBeginningOfPlayersEndStepNextTurn(You), ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))]))], CardPT: (Power: 4, Toughness: 3))
Card(Name: "Meandering Towershell", Typeline: (Supertypes: [], Cardtypes: [Creature], Subtypes: [Turtle]), ManaCost: [ManaCostGeneric(3), ManaCostG, ManaCostG], Rules: [Landwalk(IsLandType(Island)), TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), ActionList([Exile([Permanent(Trigger_ThatCreature)], []), CreateFutureTrigger(AtTheBeginningOfPlayersDeclareAttackersStepOnTheirNextTurn(You), ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderPlayersControl(You), EntersTapped, EntersAttacking])]))]))], CardPT: (Power: 5, Toughness: 9))
Card(Name: "Suppress", Typeline: (Supertypes: [], Cardtypes: [Sorcery], Subtypes: []), ManaCost: [ManaCostGeneric(2), ManaCostB], Rules: [SpellActions(Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, Exile([PlayersHand(Ref_TargetPlayer)], [ExilesFaceDown])), CreateFutureTrigger(AtTheBeginningOfPlayersEndStepNextTurn(Ref_TargetPlayer), ActionList([PlayerAction(Ref_TargetPlayer, ReturnEachExiledCardToOwnersHand(TheCardsExiledThisWay))]))])))])
