Vanguard(Name: "Maelstrom Archangel Avatar", Typeline: (Supertypes: [], Cardtypes: [Vanguard], Subtypes: []), Rules: [TriggerA(AtTheEndOfCombat, ActionList([CreateCopiesOfRandomCardsWithManaCosts(ManaCostsOfCombatCreatures(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), DealtCombatDamageToAPlayerThisTurn(AnyPlayer)]))), MayCost(PayMana([ManaCostGeneric(3)])), If(CostWasPaid, [ChooseCopyFromCopies, IfElse(CopiedCardPassesFilter(IsPermanent), [MayAction(CreateTokens([TokenFromCopy], []))], [MayAction(CastCopiedCardWithoutPaying)])])]))], LifeModifier: +5, HandModifier: +0)
