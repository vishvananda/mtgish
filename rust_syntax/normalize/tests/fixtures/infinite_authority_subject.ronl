Card(Name: "Infinite Authority", Typeline: (Supertypes: [], Cardtypes: [Enchantment], Subtypes: [Aura]), ManaCost: [ManaCostW, ManaCostW, ManaCostW], Rules: [EnchantPermanent(IsCardtype(Creature)), TriggerA(Or([WhenACreatureBecomesBlockedByACreature(SinglePermanent(HostPermanent), And([IsCardtype(Creature), ToughnessIs(LessThanOrEqualTo(Integer(3)))])), WhenACreatureBlocksACreature(SinglePermanent(HostPermanent), And([IsCardtype(Creature), ToughnessIs(LessThanOrEqualTo(Integer(3)))]))]), ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([MustCost(DestroyPermanent(Trigger_ThatOtherCreature)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutCounters([ACounterOfTypeOnPermanent(PTCounter(+1, +1), Trigger_ThatPermanent)])]))])]))]))])
